# ─────────────────────────────────────────────────────────────────────────────
#  traudio · .env.example
#
#  Copiez ce fichier en `.env` à la racine et remplissez les valeurs.
#  Le vrai `.env` est git-ignored — ne jamais commit de clé réelle.
#
#  Toutes les vars ci-dessous sont utilisées par `docker-compose.yml` ou par
#  un service précis (gateway, pipeline, llm, watcher, frontend).
# ─────────────────────────────────────────────────────────────────────────────


# ── LLM providers (au moins un est requis) ──────────────────────────────────
# OpenAI = provider par défaut en prod. Récupérer une clé :
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq = fallback rapide + free tier généreux. https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic Claude = fallback qualité. https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modèle LLM par défaut. Format LiteLLM : "provider/model".
# Exemples : openai/gpt-4o-mini · groq/llama-3.1-8b-instant · anthropic/claude-3-5-haiku
LLM_MODEL=openai/gpt-4o-mini


# ── OpenAI Realtime (feature Live speech-to-speech, optionnel) ──────────────
# Model utilisé par le POC live. Voir platform.openai.com pour la liste à jour.
OPENAI_REALTIME_MODEL=gpt-realtime


# ── TTS Mistral Voxtral (Meeting + Pipeline) ────────────────────────────────
# https://console.mistral.ai/
MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MISTRAL_VOICE_ID=alloy


# ── Whisper (STT) ───────────────────────────────────────────────────────────
# Modèle par défaut. Options : tiny, small, medium, large-v3
# small = rapide (250 Mo). large-v3 = qualité max (3 Go, recommandé prod).
WHISPER_MODEL=large-v3
NEXT_PUBLIC_DEFAULT_WHISPER_MODEL=large-v3


# ── Auth JWT (Gateway) ──────────────────────────────────────────────────────
# Secret HS256 pour signer les JWT. GÉNÉRER UN LONG STRING RANDOM :
# openssl rand -base64 32
JWT_SECRET=change-me-in-production-use-at-least-32-random-chars

# Mode dev = pas de HTTPS obligatoire côté cookies. Passer à "false" en prod.
DEV_MODE=true


# ── Langfuse (observability LLM, cloud ou self-hosted) ──────────────────────
# Créer un projet sur https://cloud.langfuse.com puis récupérer les 2 clés.
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com


# ── Watcher (poll radio 107.7) — DESACTIVE en v0.2 ──────────────────────────
# Le service watcher est retire de la stack de production (voir docker-compose.yml
# pour le contexte legal/produit). Les variables ci-dessous ne sont utilisees
# que si tu decommentes le service dans docker-compose.yml.
# POLL_INTERVAL_S=300
# MAX_EVENTS_PER_ZONE=50


# ── Prompt (LLM traduction) ─────────────────────────────────────────────────
# Version du prompt par défaut. v1.0 = basique · v1.1 = pro traffic (défaut)
# v1.2 = broadcast quality.
PROMPT_VERSION=v1.1


# ── TTS backend ─────────────────────────────────────────────────────────────
# "voxtral" (Mistral, langues majeures) ou "mms" (Meta MMS-TTS, langues rares).
# Le routing se fait automatiquement par langue cible. Cette var force un backend.
TTS_BACKEND=auto


# ── Frontend Next.js — URLs backend ─────────────────────────────────────────
# En local (Docker Compose) : les valeurs par défaut suffisent.
# En prod : mettre les URLs publiques (ex: https://traduction-audio.fr).
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8004
NEXT_PUBLIC_PIPELINE_URL=http://localhost:8000
NEXT_PUBLIC_STT_URL=http://localhost:8001
NEXT_PUBLIC_LLM_URL=http://localhost:8002


# ── Stripe billing ──────────────────────────────────────────────────────────
# Recuperer depuis https://dashboard.stripe.com/apikeys pour ton compte
# 'traduction-audio.fr'. En dev, prefixe test_ : sk_test_... / pk_test_...
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_STRIPE_SECRET
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_live_REPLACE_WITH_YOUR_STRIPE_PUBLIC

# Signature secret du webhook Stripe. Cree dans le dashboard :
# Developpeurs -> Webhooks -> + Add endpoint
# URL a mettre : https://traduction-audio.fr/api/billing/webhook
# Events a cocher : customer.subscription.{created,updated,deleted},
#                   invoice.{paid,payment_failed}, checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SIGNING_SECRET

# Prices IDs (creer les produits dans Stripe puis coller les price_... ici)
# Voir docs/BILLING_SETUP.md pour les etapes de creation dans le dashboard.
STRIPE_PRICE_PRO_MONTHLY=price_REPLACE_WITH_YOUR_MONTHLY_PRICE_ID
STRIPE_PRICE_PRO_YEARLY=price_REPLACE_WITH_YOUR_YEARLY_PRICE_ID

# URL de base de l'app (utilise pour construire les success_url / cancel_url)
APP_BASE_URL=https://traduction-audio.fr
